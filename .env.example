# Postgres connection string. REQUIRED in production (e.g. on Vercel: add a
# Neon database from Storage → Create Database, which sets DATABASE_URL for you,
# or paste a connection string from any Postgres provider).
# When unset in local dev, the app uses an embedded Postgres (PGlite) stored in ./data/pg.
DATABASE_URL=

# Password for the /admin dashboard. REQUIRED in production — deployments on
# Vercel refuse to serve admin/attendee auth without it (the dev-only default
# "eir-admin" applies locally only). Use a long, strong value.
ADMIN_PASSWORD=

# Secret used to sign session/attendee cookies. Falls back to ADMIN_PASSWORD,
# then to a dev-only default. Set a long random value in production.
SESSION_SECRET=

# Anthropic API key for the AI primer generator (admin can upload a deck/memo
# or record a voice note and get a draft primer). Optional — without it the
# generator shows a "not configured" message and manual editing still works.
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# IANA timezone used to decide which day an event "happens" (landing-page
# listing, default date on the new-event form). Default: America/Los_Angeles
EVENT_TIMEZONE=

# Where the local PGlite dev database lives (default: ./data). Ignored when
# DATABASE_URL is set.
DATA_DIR=
