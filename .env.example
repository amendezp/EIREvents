# Password for the /admin dashboard. Defaults to "eir-admin" in development —
# ALWAYS set a strong value in production.
ADMIN_PASSWORD=

# Secret used to sign session/attendee cookies. Falls back to ADMIN_PASSWORD,
# then to a dev-only default. Set a long random value in production.
SESSION_SECRET=

# Where the SQLite database file lives. Defaults to ./data
# On a host like Fly.io/Railway, point this at a persistent volume.
DATA_DIR=
