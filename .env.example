# Postgres connection string. REQUIRED in production (e.g. on Vercel: add a
# Neon database from Storage → Create Database, which sets DATABASE_URL for you,
# or paste a connection string from any Postgres provider).
# When unset in local dev, the app uses an embedded Postgres (PGlite) stored in ./data/pg.
DATABASE_URL=

# Password for the /admin dashboard. Defaults to "eir-admin" in development —
# ALWAYS set a strong value in production.
ADMIN_PASSWORD=

# Secret used to sign session/attendee cookies. Falls back to ADMIN_PASSWORD,
# then to a dev-only default. Set a long random value in production.
SESSION_SECRET=

# Where the local PGlite dev database lives (default: ./data). Ignored when
# DATABASE_URL is set.
DATA_DIR=
